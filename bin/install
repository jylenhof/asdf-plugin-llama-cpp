#!/usr/bin/env bash

set -euo pipefail

install_path="$ASDF_INSTALL_PATH"
download_path="$ASDF_DOWNLOAD_PATH"

# Create standard asdf-like directory structure
mkdir -p "$install_path/bin"
mkdir -p "$install_path/lib"
mkdir -p "$install_path/libexec"

# 1. Move all extracted files to libexec
cp -r "$download_path"/* "$install_path/libexec/"

# 2. Extract shared libraries to /lib (cleaning up the binary folder)
find "$install_path/libexec" -maxdepth 1 -type f \( -name "*.so*" -o -name "*.dylib" -o -name "*.dll" \) \
    -exec mv {} "$install_path/lib/" \;

# 3. Create wrappers for each executable (e.g., llama-cli, llama-server)
# This prevents LD_LIBRARY_PATH from leaking into your global environment.
find "$install_path/libexec" -maxdepth 1 -type f -executable \
    ! -name "*.so*" ! -name "*.dylib" ! -name "*.dll" | while read -r binary; do

    bin_name=$(basename "$binary")
    wrapper="$install_path/bin/$bin_name"

    cat <<EOF > "$wrapper"
#!/usr/bin/env bash
# Automatically generated by asdf-llama-cpp
export LD_LIBRARY_PATH="$install_path/lib:\${LD_LIBRARY_PATH:-}"
export DYLD_LIBRARY_PATH="$install_path/lib:\${DYLD_LIBRARY_PATH:-}"
exec "$binary" "\$@"
EOF

    chmod +x "$wrapper"
done

echo "llama.cpp $ASDF_INSTALL_VERSION installed with local library path isolation."
